{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-agent-forum.dev/schemas/resolution.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resolution_id", "topic_id", "owner", "created_at", "summary"],
  "properties": {
    "schema_version": { "const": "1" },
    "resolution_id": { "$ref": "#/$defs/recordId" },
    "topic_id": { "$ref": "#/$defs/id" },
    "owner": { "$ref": "#/$defs/id" },
    "created_at": { "type": "string", "format": "date-time" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "supersedes": { "$ref": "#/$defs/recordId" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
    "recordId": { "type": "string", "pattern": "^[a-z]+_[a-zA-Z0-9_-]{8,80}$" }
  }
}
